{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"],
    "strictNullChecks": true, // Enforce strict null checks for better type safety
    "paths": {
      "@/*": ["./src/*"], // Keep app-specific alias
      // Aliases for shared libs and nestjs app are inherited from tsconfig.base.json
    }
  },
  "include": [
    "next-env.d.ts", // Include Next.js environment types
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "../../node_modules/next/dist/client/image-component.js", // Keep for compatibility
    ".next/types/**/*.ts" // Include Next.js generated types
  ],
  "exclude": ["node_modules", "dist", ".next", "**/jest.config.ts", "**/*.spec.ts", "**/*.test.ts"] // Exclude test files and build outputs
}
