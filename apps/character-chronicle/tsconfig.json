{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"],
    "strictNullChecks": false,
    // Ensure paths from tsconfig.base.json are resolved correctly
    "paths": {
      "@/*": ["./apps/character-chronicle/src/*"],
      "@/nestjs/*": ["./apps/api/src/*"], // Add path alias for NestJS modules
      "@character-chronicle/shared/data": ["../../libs/shared/data/src/index.ts"],
      "@character-chronicle/shared/firebase": ["../../libs/shared/firebase/src/index.ts"],
      "@character-chronicle/shared/types": ["../../libs/shared/types/src/index.ts"],
      "@character-chronicle/shared/utils": ["../../libs/shared/utils/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "../../node_modules/next/dist/client/image-component.js",
    ".next/types/**/*.ts",
    "src/nestjs/**/*.ts" // Include NestJS source files for type checking if needed by frontend types
  ],
  "exclude": ["node_modules", "dist", ".next"]
}

    